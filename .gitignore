# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Training outputs: rsync from the server, never commit (spec §4.1)
runs/
*.pt
*.pth

# Derived data that is cheap to rebuild (e.g. data/cache/solve4x4.npz)
data/cache/

# Web
web/node_modules/
web/dist/

# LaTeX build files (latexmk leaves these in report/; tectonic doesn't). The draft PDF is a build
# output too; the finished report gets published as web/public/report.pdf (spec §6, Dec 16).
report/main.pdf
report/*.aux
report/*.bbl
report/*.blg
report/*.fdb_latexmk
report/*.fls
report/*.log
report/*.out
report/*.synctex.gz

# Course materials and papers stay out of the public repo
docs/private/

# OS / editor
.DS_Store
.vscode/
.idea/

# git worktrees, e.g. the checkout of E2's commit that `make sweep-6x6-extra` trains from
.worktrees/
